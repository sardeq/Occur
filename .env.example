# Copy to .env and fill in. Leave the Firebase keys empty to run the app in
# local demo mode (sample data, no backend).

# Firebase → Project settings → General → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Google Cloud Console of the Firebase project → Credentials)
# Web client: Firebase creates it when you enable Google sign-in ("Web client (auto created by Google Service)")
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# iOS client (bundle id com.delv.occur); its reversed form becomes the iOS URL scheme
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# Ask (AI) still runs as a Supabase Edge Function — Cloud Functions need Firebase's paid plan.
# Supabase → Project Settings → API. Leave empty to answer questions on the device only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: force demo mode even when Firebase is configured
# EXPO_PUBLIC_DEMO=1
